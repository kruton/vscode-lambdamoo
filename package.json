{
  "name": "vscode-lambdamoo",
  "displayName": "LambdaMOO Language Support",
  "description": "LambdaMOO code development support package",
  "version": "0.3.1",
  "publisher": "kruton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kruton/vscode-lambdamoo.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "lambdamoo",
    "moo",
    "lsp",
    "tree-sitter"
  ],
  "activationEvents": [
    "onFileSystem:moo"
  ],
  "main": "./out/extension.js",
  "browser": "./out/web/extension.js",
  "files": [
    "LICENSE",
    "language-configuration.json",
    "out/**/*.js",
    "out/**/*.wasm",
    "syntaxes/**"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lambdamoo.toggleLineComment",
        "title": "Toggle Line Comment",
        "category": "LambdaMOO"
      },
      {
        "command": "lambdamoo.toggleBlockComment",
        "title": "Toggle Block Comment",
        "category": "LambdaMOO"
      },
      {
        "command": "lambdamoo.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "LambdaMOO"
      },
      {
        "command": "lambdamoo.openRemote",
        "title": "Open Remote MOO",
        "category": "LambdaMOO"
      },
      {
        "command": "lambdamoo.manageRemoteConnections",
        "title": "Manage Remote MOO Connections",
        "category": "LambdaMOO"
      }
    ],
    "keybindings": [
      {
        "command": "lambdamoo.toggleLineComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && editorLangId == lambdamoo"
      },
      {
        "command": "lambdamoo.toggleBlockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && editorLangId == lambdamoo"
      }
    ],
    "configurationDefaults": {
      "[lambdamoo]": {
        "editor.defaultFormatter": "kruton.vscode-lambdamoo",
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "LambdaMOO",
      "properties": {
        "lambdamoo.webdav.cacheTtlMs": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "scope": "window",
          "description": "How long WebDAV directory and metadata results remain cached in milliseconds. Set to 0 to disable completed-result caching while retaining request coalescing."
        },
        "lambdamoo.connections": {
          "type": "array",
          "default": [],
          "scope": "application",
          "description": "Remote MOO connection profiles. Passwords are stored separately in VS Code's encrypted secret storage.",
          "items": {
            "type": "object",
            "required": [
              "authority",
              "adapter",
              "endpoint"
            ],
            "additionalProperties": false,
            "properties": {
              "authority": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
                "description": "Unique lowercase authority used in moo:// URIs."
              },
              "adapter": {
                "type": "string",
                "enum": [
                  "webdav"
                ],
                "description": "Transport adapter. Only WebDAV is currently supported."
              },
              "endpoint": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://",
                "description": "HTTP or HTTPS WebDAV URL prefix."
              },
              "username": {
                "type": "string",
                "description": "WebDAV username. Leave empty for anonymous access."
              }
            }
          }
        }
      }
    },
    "languages": [
      {
        "id": "lambdamoo",
        "aliases": [
          "LambdaMOO",
          "moo"
        ],
        "extensions": [
          ".moo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lambdamoo",
        "scopeName": "source.lambdamoo",
        "path": "./syntaxes/lambdamoo.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "lambdamoo",
        "scopes": {
          "variable": [
            "variable.other.readwrite.lambdamoo"
          ],
          "property": [
            "variable.other.property.lambdamoo"
          ],
          "function": [
            "entity.name.function.lambdamoo"
          ],
          "method": [
            "entity.name.function.member.lambdamoo"
          ],
          "keyword": [
            "keyword.control.lambdamoo"
          ],
          "comment": [
            "comment.line.string.lambdamoo"
          ],
          "string": [
            "string.quoted.double.lambdamoo"
          ],
          "number": [
            "constant.numeric.lambdamoo"
          ],
          "operator": [
            "keyword.operator.lambdamoo"
          ],
          "enumMember": [
            "constant.language.error.lambdamoo"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package:desktop && npm run package:web",
    "compile": "tsc --noEmit -p ./ && node esbuild.mjs --desktop",
    "compile:test": "node -e \"require('node:fs').rmSync('.test-out',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "package:desktop": "tsc --noEmit -p ./ && node esbuild.mjs --desktop --production",
    "compile:web": "tsc --noEmit -p tsconfig.web.json && node esbuild.mjs",
    "package:web": "tsc --noEmit -p tsconfig.web.json && node esbuild.mjs --production",
    "watch:web": "node esbuild.mjs --watch",
    "watch": "node esbuild.mjs --desktop --watch",
    "check": "npm run compile && npm run compile:web && npm run compile:test",
    "test": "npm run compile:test && npm run test:unit && npm run test:extension",
    "test:unit": "node --test .test-out/test/unit/remoteFileSystemLogic.test.js",
    "test:extension": "node .test-out/test/runTest.js"
  },
  "dependencies": {
    "@kruton/moo-lsp": "^0.2.12",
    "vscode-languageclient": "^10.1.0",
    "vscode-jsonrpc": "^9.0.1",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "ovsx": "1.1.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.2": true
  }
}
